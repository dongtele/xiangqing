.vt {
  display: flex;
  flex-direction: column;
}

.vt__row {
  display: flex;
  gap: 24rpx;
}

.vt__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.vt__dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--c-border-btn);
  margin-top: 8rpx;
}

.vt__dot--on {
  background: var(--c-primary);
}

.vt__line {
  width: 4rpx;
  flex: 1;
  min-height: 68rpx;
  background: #efe8e0;
}

.vt__line--on {
  background: var(--c-primary);
}

.vt__text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.vt__text--gap {
  padding-bottom: 16rpx;
}

.vt__title {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--c-text);
}

.vt__title--todo {
  font-weight: 600;
  color: var(--c-text-weaker);
}

.vt__sub {
  font-size: 22rpx;
  color: var(--c-text-weaker);
}
