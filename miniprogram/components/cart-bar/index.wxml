<view
  wx:if="{{count > 0}}"
  class="cartbar"
  style="bottom:calc({{bottom}}rpx + env(safe-area-inset-bottom))"
>
  <view class="cartbar__icon tap-sm" bindtap="onOpen">
    <icon-svg name="cart" size="42" color="#FFFFFF" />
    <text class="cartbar__badge {{bump ? 'cartbar__badge--bump' : ''}}">{{count}}</text>
  </view>
  <view class="cartbar__mid tap" bindtap="onOpen">
    <text class="cartbar__total">¥{{totalText}}</text>
    <text wx:if="{{promoText}}" class="cartbar__promo">{{promoText}}</text>
  </view>
  <view class="cartbar__btn tap" bindtap="onCheckout">去结算</view>
</view>
