<view
  class="mask {{show ? 'mask--on' : ''}}"
  bindtap="onClose"
  catchtouchmove="noop"
/>

<view class="sheet {{show ? 'sheet--on' : ''}}" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">已选商品（{{count}}件）</text>
    <view class="sheet__clear tap" bindtap="onClear">
      <icon-svg name="trash" size="24" color="#A39890" weight="2" />
      <text>清空</text>
    </view>
  </view>

  <view wx:if="{{promoText}}" class="sheet__promo">
    <text class="sheet__promo-main">{{promoText}}</text>
    <text wx:if="{{promoNote}}" class="sheet__promo-note">{{promoNote}}</text>
  </view>

  <scroll-view class="sheet__list" scroll-y>
    <view wx:for="{{rows}}" wx:key="key" class="sheet__row">
      <image class="sheet__thumb" src="{{item.image}}" mode="aspectFill" lazy-load />
      <view class="sheet__info">
        <text class="sheet__name">{{item.name}}</text>
        <text wx:if="{{item.specText}}" class="sheet__spec">{{item.specText}}</text>
        <view class="sheet__price">
          <text>¥{{item.lineText}}</text>
          <text wx:if="{{item.unit}}" class="sheet__unit">{{item.unit}}</text>
        </view>
      </view>
      <qty-stepper
        qty="{{item.qty}}"
        plus-size="50"
        minus-size="50"
        font-size="27"
        always-minus
        data-key="{{item.key}}"
        bindplus="onPlus"
        bindminus="onMinus"
      />
    </view>
  </scroll-view>

  <view class="sheet__foot">
    <view class="sheet__cart">
      <icon-svg name="cart" size="42" color="#FFFFFF" />
      <text class="sheet__badge">{{count}}</text>
    </view>
    <view class="sheet__sum">
      <text class="sheet__sum-total">¥{{totalText}}</text>
      <text wx:if="{{footerNote}}" class="sheet__sum-note">{{footerNote}}</text>
    </view>
    <view class="sheet__btn tap" bindtap="onCheckout">去结算</view>
  </view>
</view>
