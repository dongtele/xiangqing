.mask {
  position: fixed;
  inset: 0;
  background: rgba(32, 22, 15, 0.45);
  z-index: 60;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.mask--on {
  opacity: 1;
  pointer-events: auto;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  max-height: 76vh;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(110%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet--on {
  transform: translateY(0);
}

.sheet__head {
  padding: 32rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #f7f3ee;
  flex-shrink: 0;
}

.sheet__title {
  font-size: 30rpx;
  font-weight: 800;
}

.sheet__clear {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: var(--c-text-weaker);
}

.sheet__promo {
  background: var(--c-warn-bg);
  padding: 16rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.sheet__promo-main {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--c-warn-text-2);
}

.sheet__promo-note {
  font-size: 21rpx;
  color: var(--c-warn-text);
}

.sheet__list {
  flex: 1;
  min-height: 160rpx;
  max-height: 46vh;
  padding: 0 40rpx;
}

.sheet__row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid #f9f6f1;
}

.sheet__row:last-child {
  border-bottom: none;
}

.sheet__thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  background: var(--c-img-placeholder);
  flex-shrink: 0;
}

.sheet__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sheet__name {
  font-size: 26rpx;
  font-weight: 700;
}

.sheet__spec {
  font-size: 21rpx;
  color: var(--c-text-weaker);
}

.sheet__price {
  display: flex;
  align-items: baseline;
  color: var(--c-primary-deep);
  font-weight: 800;
  font-size: 26rpx;
}

.sheet__unit {
  font-size: 20rpx;
  color: var(--c-text-placeholder);
  font-weight: 500;
}

.sheet__foot {
  padding: 20rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-top: 1px solid #f7f3ee;
  flex-shrink: 0;
}

.sheet__cart {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--grad-main);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet__badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #fff;
  color: var(--c-primary-deep);
  font-size: 20rpx;
  font-weight: 800;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 18rpx;
  border: 3rpx solid #ff3d00;
}

.sheet__sum {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.sheet__sum-total {
  font-weight: 800;
  font-size: 34rpx;
}

.sheet__sum-note {
  color: var(--c-primary);
  font-size: 19rpx;
}

.sheet__btn {
  background: var(--grad-main);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  padding: 24rpx 52rpx;
  border-radius: 48rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 61, 0, 0.28);
}
