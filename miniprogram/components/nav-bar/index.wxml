<view
  class="nav {{fixed ? 'nav--fixed' : ''}} {{theme === 'dark' ? 'nav--dark' : ''}}"
  style="background:{{bg}}"
>
  <view style="height:{{statusBarHeight}}px" />
  <view class="nav__row" style="height:{{navBarHeight}}px">
    <view
      wx:if="{{showBack}}"
      class="nav__back tap"
      hover-class="none"
      bindtap="onBack"
      aria-role="button"
      aria-label="返回"
    >
      <text class="nav__back-glyph">‹</text>
    </view>
    <text class="nav__title">{{title}}</text>
    <text wx:if="{{right}}" class="nav__right tap" bindtap="onRight">{{right}}</text>
  </view>
</view>
