<view class="rc">
  <nav-bar title="联系骑手" />

  <view class="rc__body">
    <view class="card rc__rider">
      <view class="rc__avatar">{{rider.avatarText}}</view>
      <view class="flex1 col rc__rider-text">
        <text class="rc__rider-name">{{rider.titleText}}</text>
        <text class="rc__rider-credit">{{rider.creditText}}</text>
      </view>
      <view class="rc__call tap" bindtap="onCall">
        <icon-svg name="phone" size="36" color="#FFFFFF" weight="2" />
      </view>
    </view>

    <view class="rc__notice">
      为保护双方隐私，通话将使用虚拟号码
      <text class="rc__notice-num">{{rider.virtualPhone}}</text>
      转接，订单完成后失效。
    </view>

    <scroll-view
      class="rc__chat"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollInto}}"
      scroll-with-animation
    >
      <block wx:for="{{messages}}" wx:key="id">
        <view wx:if="{{item.timeText}}" class="rc__time">
          <text class="rc__time-pill">{{item.timeText}}</text>
        </view>
        <view id="msg-{{item.id}}" class="rc__bubble rc__bubble--{{item.from}}">{{item.text}}</view>
      </block>
    </scroll-view>

    <view class="rc__quick">
      <text
        wx:for="{{quickReplies}}"
        wx:key="*this"
        class="rc__quick-item tap"
        data-text="{{item}}"
        bindtap="onQuickReply"
      >{{item}}</text>
    </view>

    <view class="rc__input">
      <input
        class="rc__input-field"
        value="{{draft}}"
        placeholder="发消息给骑手…"
        placeholder-class="rc__input-ph"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <view class="rc__send tap" bindtap="onSend">发送</view>
    </view>
  </view>
</view>
