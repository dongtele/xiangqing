<view class="mo">
  <view class="mo__header" style="padding-top:{{headPad}}px">
    <view class="row--between">
      <text class="mo__title">订单管理</text>
      <view class="mo__scan tap" bindtap="onScan">
        <icon-svg name="scan" size="28" color="#FF4A17" weight="2" />
        <text>核销取餐码</text>
      </view>
    </view>
    <scroll-view class="mo__tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="mo__tab {{activeTab === item.key ? 'mo__tab--on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSwitchTab"
      >{{item.label}}{{counts[item.key] ? ' ' + counts[item.key] : ''}}</view>
    </scroll-view>
  </view>

  <scroll-view class="mo__body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="card card--lg">
      <view class="skeleton" style="width:40%;height:32rpx" />
      <view class="skeleton" style="width:100%;height:120rpx" />
    </view>

    <block wx:elif="{{orders.length}}">
      <view
        wx:for="{{orders}}"
        wx:key="id"
        class="mo__card {{item.status === 'pending' ? 'mo__card--new' : ''}}"
      >
        <view class="row--between" data-id="{{item.id}}" bindtap="onDetail">
          <view class="row mo__seq">
            <text class="mo__channel mo__channel--{{item.channel === '自提' ? 'pickup' : 'delivery'}}">{{item.channel}}</text>
            <text class="mo__no">{{item.seq}}</text>
          </view>
          <text
            wx:if="{{item.countdownText}}"
            class="mo__countdown"
          >{{item.countdownText}}</text>
          <text wx:else class="mo__status">{{item.statusText}}</text>
        </view>

        <!-- 自提：取餐码 -->
        <view wx:if="{{item.pickupCode}}" class="mo__code">
          <text class="mo__code-label">取餐码</text>
          <text class="mo__code-num">{{item.pickupCode}}</text>
        </view>

        <!-- 外送：顾客与地址 -->
        <view wx:if="{{item.addressText}}" class="mo__customer">
          <text>{{item.customerName}} {{item.customerPhone}}</text>
          <text class="mo__customer-addr">{{item.addressText}} · {{item.distanceText}}</text>
        </view>
        <text wx:elif="{{item.summaryText}}" class="mo__summary">{{item.summaryText}}</text>

        <!-- 明细（待接单单据展开） -->
        <view wx:if="{{item.status === 'pending'}}" class="mo__items">
          <view wx:for="{{item.rows}}" wx:for-item="line" wx:key="text" class="mo__item">
            <text class="flex1">{{line.text}}</text>
            <text class="mo__item-qty">x{{line.qty}}</text>
          </view>
          <view class="mo__item mo__item--total">
            <text class="flex1">共{{item.count}}件</text>
            <text>¥{{item.totalText}}</text>
          </view>
        </view>

        <!-- 操作 -->
        <view wx:if="{{item.status === 'pending'}}" class="mo__actions">
          <view class="mo__btn mo__btn--ghost tap" data-id="{{item.id}}" bindtap="onReject">拒单</view>
          <view class="mo__btn mo__btn--primary tap" data-id="{{item.id}}" bindtap="onAccept">立即接单</view>
        </view>
        <view wx:elif="{{item.status === 'ongoing'}}" class="mo__actions">
          <view
            class="mo__btn mo__btn--ghost mo__btn--half tap"
            data-id="{{item.id}}"
            bindtap="onPrint"
          >打印小票</view>
          <view
            class="mo__btn mo__btn--outline-primary mo__btn--half tap"
            data-id="{{item.id}}"
            bindtap="onFinish"
          >出餐完成</view>
        </view>
      </view>
    </block>

    <view wx:else class="mo__empty">
      <text class="empty__text">该状态下暂无订单</text>
    </view>
  </scroll-view>

  <tab-bar role="merchant" active="orders" />
</view>
