<view class="mg">
  <view class="mg__header" style="padding-top:{{headPad}}px">
    <view class="row--between">
      <text class="mg__title">商品管理</text>
      <view class="row mg__head-actions">
        <view class="mg__pill mg__pill--grey tap" bindtap="onCategoryManage">分类管理</view>
        <view class="mg__pill mg__pill--primary tap" bindtap="onCreate">＋ 发布商品</view>
      </view>
    </view>

    <view class="mg__search">
      <icon-svg name="search" size="26" color="#B0A69D" weight="2.4" />
      <input
        class="mg__search-input"
        value="{{keyword}}"
        placeholder="搜索商品名称"
        placeholder-class="mg__search-ph"
        bindinput="onSearchInput"
      />
    </view>

    <scroll-view class="mg__cats" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="mg__cat {{activeCategory === item ? 'mg__cat--on' : ''}}"
        data-name="{{item}}"
        bindtap="onSwitchCategory"
      >{{item}}</view>
    </scroll-view>
  </view>

  <scroll-view class="mg__body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="mg__card">
      <view class="skeleton" style="width:148rpx;height:148rpx;border-radius:24rpx" />
      <view class="flex1 col" style="gap:12rpx">
        <view class="skeleton" style="width:60%;height:28rpx" />
        <view class="skeleton" style="width:40%;height:24rpx" />
      </view>
    </view>

    <block wx:elif="{{list.length}}">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="mg__card {{item.onSale ? '' : 'mg__card--off'}}"
      >
        <view class="mg__thumb-wrap" data-id="{{item.id}}" bindtap="onEdit">
          <image
            class="mg__thumb {{item.stockLevel === 'out' ? 'mg__thumb--out' : ''}}"
            src="{{item.image}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:if="{{item.stockLevel === 'out'}}" class="mg__out">
            <text class="mg__out-text">售罄</text>
          </view>
        </view>

        <view class="mg__info" data-id="{{item.id}}" bindtap="onEdit">
          <text class="mg__name">{{item.name}}</text>
          <view class="mg__tags">
            <text class="mg__tag">{{item.categoryName}}</text>
            <text wx:if="{{item.stockLevel === 'low'}}" class="mg__tag mg__tag--low">{{item.specCountText}}</text>
            <text wx:elif="{{item.stockLevel === 'out'}}" class="mg__tag mg__tag--out">{{item.specCountText}}</text>
            <text wx:else class="mg__stock">{{item.specCountText}}</text>
          </view>
          <price-text fen="{{item.price}}" size="32" from="{{item.priceFrom}}" />
        </view>

        <view class="mg__right">
          <block wx:if="{{item.stockLevel === 'out'}}">
            <view class="pill pill--outline-primary tap" data-id="{{item.id}}" bindtap="onRestock">补货</view>
          </block>
          <block wx:else>
            <toggle
              size="sm"
              on="{{item.onSale}}"
              data-id="{{item.id}}"
              bindchange="onToggleSale"
            />
            <text class="mg__sale-label {{item.onSale ? 'mg__sale-label--on' : ''}}">{{item.onSale ? '售卖中' : '已下架'}}</text>
          </block>
        </view>
      </view>
    </block>

    <view wx:else class="mg__empty">
      <text class="empty__text">没有匹配的商品</text>
    </view>
  </scroll-view>

  <tab-bar role="merchant" active="goods" />
</view>
