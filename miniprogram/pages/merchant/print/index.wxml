<view class="pt">
  <nav-bar title="打印设置" right="测试打印" bindrighttap="onTestPrint" />

  <scroll-view class="pt__body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 设备 -->
    <view class="card">
      <view class="pt__device tap" bindtap="onManageDevice">
        <view class="pt__device-icon">
          <icon-svg name="printer" size="40" color="#FF4A17" />
        </view>
        <view class="flex1 col pt__device-text">
          <text class="pt__device-name">{{settings.device.name}}</text>
          <text class="pt__device-status {{settings.device.online ? 'pt__device-status--on' : 'pt__device-status--off'}}">● {{settings.device.statusText}}</text>
        </view>
        <text class="pt__manage">管理 ›</text>
      </view>
    </view>

    <!-- 打印设置 -->
    <view class="card">
      <view class="pt__row">
        <view class="col pt__row-text">
          <text class="cell__label">自动打印</text>
          <text class="pt__row-sub">接单后立即打印后厨联</text>
        </view>
        <toggle on="{{settings.autoPrint}}" bindchange="onToggleAuto" />
      </view>
      <view class="hairline" />
      <view class="pt__row tap" bindtap="onPickCopies">
        <view class="col pt__row-text">
          <text class="cell__label">打印联数</text>
          <text class="pt__row-sub">{{settings.copies > 1 ? '后厨联 + 顾客联' : '仅后厨联'}}</text>
        </view>
        <view class="cell__value">
          <text>{{settings.copiesText}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
      <view class="hairline" />
      <view class="pt__row tap" bindtap="onPickWidth">
        <text class="cell__label">小票宽度</text>
        <view class="cell__value">
          <text>{{settings.width}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
      <view class="hairline" />
      <view class="pt__row">
        <text class="cell__label">打印菜品备注</text>
        <toggle on="{{settings.printRemark}}" bindchange="onToggleRemark" />
      </view>
    </view>

    <!-- 小票预览 -->
    <view wx:if="{{hasOrder}}" class="card">
      <view class="row--between">
        <text class="t-section">小票预览</text>
        <view class="pt__tabs">
          <view
            wx:for="{{tabs}}"
            wx:key="key"
            class="pt__tab {{activeTab === item.key ? 'pt__tab--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onSwitchTab"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="pt__paper">
        <text class="pt__paper-title">{{receipt.title}}</text>
        <text class="pt__paper-meta">{{receipt.meta}}</text>
        <view class="pt__dash" />
        <view wx:for="{{receipt.lines}}" wx:key="text" class="pt__paper-line">
          <text class="flex1">{{item.text}}</text>
          <text>{{item.qty}}</text>
        </view>
        <block wx:if="{{receipt.amounts.length}}">
          <view class="pt__dash" />
          <view wx:for="{{receipt.amounts}}" wx:key="label" class="pt__paper-line">
            <text class="flex1">{{item.label}}</text>
            <text>{{item.value}}</text>
          </view>
        </block>
        <block wx:if="{{receipt.remark}}">
          <view class="pt__dash" />
          <text class="pt__paper-remark">{{receipt.remark}}</text>
        </block>
        <block wx:if="{{receipt.footer}}">
          <view class="pt__dash" />
          <text class="pt__paper-footer">{{receipt.footer}}</text>
        </block>
      </view>
    </view>

    <view wx:else class="card pt__hint">
      <text class="empty__text">从订单详情进入可预览并补打该单小票</text>
    </view>

    <view class="pt__foot" />
  </scroll-view>

  <view wx:if="{{hasOrder}}" class="pt__bar">
    <view class="btn btn--primary tap" bindtap="onReprint">补打小票（{{settings.copiesText}}）</view>
  </view>
</view>
