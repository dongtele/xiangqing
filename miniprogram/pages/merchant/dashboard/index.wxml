<view class="dash">
  <scroll-view class="dash__scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="dash__inner" style="padding-top:{{topPad}}px">
      <!-- 店铺 + 营业状态 -->
      <view class="dash__top">
        <view class="col dash__shop">
          <text class="dash__shop-name">{{dash.shopName}}</text>
          <text class="dash__shop-meta">{{dash.scoreText}}</text>
        </view>
        <view class="dash__open {{dash.open ? '' : 'dash__open--off'}}">
          <view class="dash__open-dot" />
          <text>{{dash.open ? '营业中' : '休息中'}}</text>
        </view>
      </view>

      <!-- 待处理 -->
      <view class="dash__todo tap" bindtap="onGoOrders">
        <block wx:for="{{dash.todos}}" wx:key="label">
          <view wx:if="{{index > 0}}" class="dash__todo-div" />
          <view class="dash__todo-item">
            <text class="dash__todo-num {{item.highlight ? 'dash__todo-num--hot' : ''}}">{{item.value}}</text>
            <text class="dash__todo-label">{{item.label}}</text>
          </view>
        </block>
        <text class="dash__todo-arrow">›</text>
      </view>

      <!-- 今日实时 -->
      <view class="card card--lg">
        <view class="row--between">
          <text class="t-section">今日实时</text>
          <text class="dash__range tap" bindtap="onTapRange">今日 ▾</text>
        </view>
        <view class="dash__metrics">
          <view wx:for="{{dash.metrics}}" wx:key="label" class="dash__metric">
            <text class="dash__metric-label">{{item.label}}</text>
            <text class="dash__metric-value">{{item.value}}</text>
            <text class="dash__metric-delta dash__metric-delta--{{item.deltaTone}}">{{item.delta}}</text>
          </view>
        </view>
      </view>

      <!-- 近 7 天营业额 -->
      <view class="card card--lg">
        <text class="t-section">近7天营业额</text>
        <view class="dash__chart">
          <view wx:for="{{dash.trend}}" wx:key="label" class="dash__bar-col">
            <view class="dash__bar dash__bar--{{item.tone}}" style="height:{{item.percent}}%" />
            <text class="dash__bar-label {{item.tone === 'today' ? 'dash__bar-label--today' : ''}}">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 今日热销 -->
      <view class="card card--lg tap" bindtap="onTapHot">
        <text class="t-section">今日热销</text>
        <view wx:for="{{hotRows}}" wx:key="rank" class="dash__hot">
          <text class="dash__hot-rank" style="background:{{item.color}}">{{item.rank}}</text>
          <text class="dash__hot-name">{{item.name}}</text>
          <text class="dash__hot-count">{{item.countText}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <tab-bar role="merchant" active="dashboard" />
</view>
